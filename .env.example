# Use Neon's pooled (-pooler) URL for DATABASE_URL and the direct endpoint for DIRECT_URL.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Auth.js GitHub OAuth app credentials and a strong random secret.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_SECRET=""
# Numeric GitHub account ID for the only account allowed into the admin workspace.
ADMIN_GITHUB_ID=""

# Vercel Blob read/write token; needed only for profile/article image uploads.
BLOB_READ_WRITE_TOKEN=""
